---
/**
 * DESIGN FORGE BLUEPRINT: HeroStage.astro
 * Brand Instance: KINETIX AI (Autonomous Neural Compute & Spatial Engineering Cloud)
 * Exact reverse-engineered implementation of Adobe's Flagship Hero:
 *  - Full-bleed 900px viewport stage with `parallax-move-up-fast` (-180px) & `parallax-fade-to-dark` (0 -> 0.75)
 *  - Left 45% negative-space safe zone for 80px / -3.2px tracking Display Black headline
 *  - Right 55% interactive 3D/Video showcase stage (auto-loads `/media/videos/FLOW-VIDEO-01..03.mp4` when dropped in)
 *  - Bottom 5-Slot Interactive Glassmorphic Dock (`rm-card-progress-bar`) with 5000ms linear progress bar
 */
export interface HeroSlide {
  id: string;
  eyebrow: string;
  dockTitle: string;
  badgeColor: string;
  badgeLabel: string;
  headline: string;
  subheadline: string;
  promoNote: string;
  ctaText: string;
  bgGradient: string;
  stageAccent: string;
  promptSlotId: string;
  videoFile: string;
}

interface Props {
  slides?: HeroSlide[];
}

const defaultSlides: HeroSlide[] = [
  {
    id: 'slide-0',
    eyebrow: 'KINETIX KX-4 NEURAL ENGINE',
    dockTitle: 'Multi-Model Router',
    badgeColor: '#FA0F00',
    badgeLabel: 'Kx',
    headline: 'Every frontier model, one zero-latency core.',
    subheadline:
      'Route reasoning, spatial 3D synthesis, and autonomous code execution across unified GPU clusters with sub-12ms speculative decoding.',
    promoNote: 'Drop your Google Flow render at /public/media/videos/FLOW-VIDEO-01.mp4 to replace the live stage background.',
    ctaText: 'Deploy KX-4 Cluster',
    bgGradient: 'radial-gradient(circle at 75% 42%, #3b1d5e 0%, #1a0f2e 45%, #0b0b10 100%)',
    stageAccent: '#FA0F00',
    promptSlotId: 'FLOW-VIDEO-01',
    videoFile: '/media/videos/refencefromadobe_1080p_20261017215844.mp4',
  },
  {
    id: 'slide-1',
    eyebrow: 'SPATIAL SHADER & 3D SYNTHESIS',
    dockTitle: 'Spatial Compute',
    badgeColor: '#FF5C00',
    badgeLabel: 'Sp',
    headline: 'Compile physical worlds at 120 frames per second.',
    subheadline:
      'Generate production-ready WebGPU shaders, physically based refractive materials, and deterministic physics meshes from a single API call.',
    promoNote: 'Live Google Flow Render mounted from /public/media/videos/3D_node_graph_floating_animation_20261017220352.mp4',
    ctaText: 'Launch Shader Studio',
    bgGradient: 'radial-gradient(circle at 72% 38%, #5e1914 0%, #240c11 48%, #0a0a0f 100%)',
    stageAccent: '#FF5C00',
    promptSlotId: 'FLOW-VIDEO-02',
    videoFile: '/media/videos/3D_node_graph_floating_animation_20261017220352.mp4',
  },
  {
    id: 'slide-2',
    eyebrow: 'AUTONOMOUS SWARM ORCHESTRATION',
    dockTitle: 'Agent Swarms',
    badgeColor: '#7A28FF',
    badgeLabel: 'Sw',
    headline: 'Orchestrate 10,000 parallel code agents.',
    subheadline:
      'Self-healing sandboxes with hardware-isolated microVMs that verify, benchmark, and ship complex full-stack PRs autonomously.',
    promoNote: 'Live Google Flow Render mounted from /public/media/videos/Timeline_and_execution_lanes_pul…_20261017220646.mp4',
    ctaText: 'Inspect Swarm Telemetry',
    bgGradient: 'radial-gradient(circle at 74% 40%, #163b6e 0%, #0d1b38 50%, #090b12 100%)',
    stageAccent: '#7A28FF',
    promptSlotId: 'FLOW-VIDEO-03',
    videoFile: '/media/videos/Timeline_and_execution_lanes_pul%E2%80%A6_20261017220646.mp4',
  },
  {
    id: 'slide-3',
    eyebrow: 'DETERMINISTIC CONTEXT GRAPH',
    dockTitle: 'Memory Fabric',
    badgeColor: '#12B867',
    badgeLabel: 'Mm',
    headline: 'Infinite repo memory with zero hallucination.',
    subheadline:
      'Index 500M+ tokens of proprietary architecture, live telemetry logs, and design system specs into a real-time AST knowledge graph.',
    promoNote: 'Live Google Flow Render mounted from /public/media/videos/Glass_prism_splitting_laser_beam_20261017220851.mp4',
    ctaText: 'Explore Memory Fabric',
    bgGradient: 'radial-gradient(circle at 75% 45%, #0c4a3e 0%, #082421 50%, #090c0e 100%)',
    stageAccent: '#2BD17D',
    promptSlotId: 'FLOW-VIDEO-04',
    videoFile: '/media/videos/Glass_prism_splitting_laser_beam_20261017220851.mp4',
  },
  {
    id: 'slide-4',
    eyebrow: 'SOVEREIGN ENTERPRISE CLOUD',
    dockTitle: 'Enterprise VPC',
    badgeColor: '#3B63FB',
    badgeLabel: 'Vp',
    headline: 'Air-gapped AI infrastructure on your metal.',
    subheadline:
      'Deploy KINETIX inside your own AWS, GCP, or bare-metal H200 clusters with SOC2 Type II, HIPAA, and zero-data-retention guarantees.',
    promoNote: 'Live Google Flow Render mounted from /public/media/videos/Interlocking_translucent_acrylic…_1080p_20261017221547.mp4',
    ctaText: 'Book Architecture Demo',
    bgGradient: 'radial-gradient(circle at 70% 40%, #3a235c 0%, #18132c 52%, #0a0a0f 100%)',
    stageAccent: '#8EB9FC',
    promptSlotId: 'FLOW-VIDEO-01',
    videoFile: '/media/videos/Interlocking_translucent_acrylic%E2%80%A6_1080p_20261017221547.mp4',
  },
];

const { slides = defaultSlides } = Astro.props;
---

<section
  id="hero"
  data-df-hero-stage
  class="relative w-full min-h-[880px] lg:h-[900px] overflow-hidden bg-[#0b0b10] text-white flex flex-col justify-between pt-[112px] pb-[44px] select-none"
>
  <!-- Dynamic Background Stages (Crossfaded by the 5-Slot Dock + Auto-plays Google Flow MP4 if present) -->
  {
    slides.map((slide, idx) => (
      <div
        data-df-hero-bg={idx}
        class:list={[
          'absolute inset-0 transition-opacity duration-700 ease-[cubic-bezier(0.42,0,0,1)]',
          idx === 0 ? 'opacity-100 z-0' : 'opacity-0 -z-10 pointer-events-none',
        ]}
        style={`background: ${slide.bgGradient};`}
      >
        <!-- Optional Drop-In Google Flow Video Background (1.10x asymmetric overscan crops out bottom-right Veo/Flow corner watermark automatically) -->
        <video
          src={slide.videoFile}
          autoplay
          loop
          muted
          playsinline
          class="absolute inset-0 w-full h-full object-cover scale-[1.10] origin-[25%_25%] opacity-85 pointer-events-none"
          onerror="this.style.display='none'"
        />

        <!-- Ambient Perspective Grid & Studio Rim Light -->
        <div
          class="absolute inset-0 opacity-25 pointer-events-none"
          style="background-image: linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 64px 64px; mask-image: radial-gradient(circle at 70% 45%, black 20%, transparent 75%);"
        />
        <!-- Directional Left-Side Safe-Zone Gradient (`linear-gradient(108deg, rgba(0, 0, 0, 0.56) 0%, rgba(0, 0, 0, 0) 98.86%)` extracted from Adobe) -->
        <div
          class="absolute inset-0 pointer-events-none"
          style="background: linear-gradient(108deg, rgba(11, 11, 16, 0.88) 0%, rgba(11, 11, 16, 0.45) 48%, rgba(0, 0, 0, 0) 98.86%);"
        />
      </div>
    ))
  }

  <!-- Extracted Scroll Darkening Overlay (`parallax-fade-to-dark` 0 -> 0.75) -->
  <div
    data-df-hero-dark-overlay
    class="pointer-events-none absolute inset-0 bg-black opacity-0 z-20"
  ></div>

  <!-- Main Hero Content Grid (Left 45% Typography Safe Zone + Right 55% Interactive Visual Stage) -->
  <div class="relative z-10 max-w-[1440px] w-full mx-auto px-6 sm:px-12 my-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
    <!-- Left 5 Columns: Extracted 80px Display Typography -->
    <div class="lg:col-span-6 xl:col-span-5 relative min-h-[390px] flex flex-col justify-center">
      {
        slides.map((slide, idx) => (
          <div
            data-df-hero-copy={idx}
            class:list={[
              'transition-all duration-500 ease-[cubic-bezier(0.42,0,0,1)]',
              idx === 0
                ? 'opacity-100 translate-y-0 relative'
                : 'opacity-0 translate-y-4 absolute inset-0 pointer-events-none',
            ]}
          >
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/15 backdrop-blur-md text-[12px] font-bold tracking-wider uppercase mb-5">
              <span class="w-2 h-2 rounded-full" style={`background: ${slide.stageAccent};`} />
              <span>{slide.eyebrow}</span>
              <span class="text-white/50 font-mono text-[11px]">[{slide.promptSlotId}]</span>
            </div>

            <h1
              class="font-black text-white tracking-[-0.04em] mb-5"
              style="font-size: clamp(2.85rem, 5.1vw, 4.9rem); line-height: 0.95;"
            >
              {slide.headline}
            </h1>

            <p class="text-[18px] sm:text-[20px] leading-[1.35] text-white/90 font-normal mb-4 max-w-[520px]">
              {slide.subheadline}
            </p>

            <p class="text-[13px] leading-[1.45] text-white/70 font-mono mb-7 max-w-[490px]">
              {slide.promoNote}
            </p>

            <div class="flex flex-wrap items-center gap-3.5">
              <a
                href="#bento"
                class="px-7 py-3.5 rounded-full bg-white text-[#131313] font-bold text-[15px] tracking-[-0.01em] hover:scale-[1.03] active:scale-[0.98] transition-transform duration-200 shadow-lg"
              >
                {slide.ctaText}
              </a>
              <a
                href="/design-system#prompts"
                class="px-6 py-3.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 backdrop-blur-md font-bold text-[14px] transition-all duration-200"
              >
                Copy {slide.promptSlotId} Prompt →
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Right 7 Columns: Interactive KINETIX Neural Compute Stage -->
    <div class="lg:col-span-6 xl:col-span-7">
      <div
        class="relative rounded-[24px] border border-white/20 bg-[#131318]/80 backdrop-blur-2xl shadow-[0_32px_80px_rgba(0,0,0,0.65)] overflow-hidden p-4 sm:p-6 transition-transform duration-700 hover:scale-[1.01]"
      >
        <!-- Top Window Chrome -->
        <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/10">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-[#FF5F56]"></span>
            <span class="w-3 h-3 rounded-full bg-[#FFBD2E]"></span>
            <span class="w-3 h-3 rounded-full bg-[#27C93F]"></span>
            <span class="ml-3 text-[12px] font-mono text-white/70 flex items-center gap-2">
              <img src="/logo-kinetix.svg" alt="" class="w-4 h-4 rounded-sm" />
              <span>kinetix://kx4-cluster/neural-stage</span>
            </span>
          </div>
          <span class="px-2.5 py-1 rounded-md bg-emerald-500/15 border border-emerald-500/30 text-[11px] font-mono text-emerald-300">
            11.4ms TTFB • 4,096 H200 GPUs
          </span>
        </div>

        <!-- Stage Visual Preview Area -->
        <div class="grid grid-cols-12 gap-4 items-stretch">
          <!-- Left Tool Sidebar -->
          <div class="col-span-4 hidden sm:flex flex-col justify-between rounded-xl bg-white/[0.04] border border-white/10 p-3.5 text-[12px]">
            <div class="space-y-3">
              <div class="text-white/50 font-semibold uppercase tracking-wider text-[10px]">Active Router</div>
              <div class="px-3 py-2 rounded-lg bg-white/10 border border-white/15 font-semibold text-white flex items-center justify-between">
                <span>KINETIX KX-4 Omni</span>
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              </div>
              <div class="text-white/50 font-semibold uppercase tracking-wider text-[10px] pt-2">Throughput</div>
              <div class="grid grid-cols-2 gap-1.5 font-mono text-[11px]">
                <div class="px-2 py-1.5 rounded bg-white/15 text-white text-center">1,420 tok/s</div>
                <div class="px-2 py-1.5 rounded bg-white/5 text-white/60 text-center">FP8 Quant</div>
              </div>
              <div class="text-white/50 font-semibold uppercase tracking-wider text-[10px] pt-2">Motion Physics</div>
              <div class="px-2.5 py-1.5 rounded bg-black/40 font-mono text-[11px] text-amber-300">
                bezier(0.42, 0, 0, 1)
              </div>
            </div>

            <div class="pt-4 border-t border-white/10 flex items-center justify-between text-[11px] text-white/60">
              <span>Safe Zone</span>
              <span class="text-emerald-400 font-semibold">Left 45% Locked</span>
            </div>
          </div>

          <!-- Right Live Video & Generative Telemetry Stage -->
          <div class="col-span-12 sm:col-span-8 flex flex-col justify-between gap-3">
            <!-- Live Crossfading Google Flow Video Viewport -->
            <div class="relative h-[220px] rounded-xl overflow-hidden border border-white/20 bg-black shadow-inner">
              {
                slides.map((slide, idx) => (
                  <video
                    data-df-hero-stage-video={idx}
                    src={slide.videoFile}
                    autoplay
                    loop
                    muted
                    playsinline
                    class:list={[
                      'absolute inset-0 w-full h-full object-cover scale-[1.08] origin-[25%_25%] transition-opacity duration-500 ease-[cubic-bezier(0.42,0,0,1)]',
                      idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none',
                    ]}
                    onerror="this.style.display='none'"
                  />
                ))
              }
              <div class="absolute top-2.5 left-2.5 z-20 flex items-center gap-2 px-2.5 py-1 rounded-md bg-black/60 backdrop-blur-md border border-white/15 text-[10px] font-mono text-white/90">
                <span class="w-2 h-2 rounded-full bg-[#FA0F00] animate-pulse"></span>
                <span data-df-stage-slot-label>LIVE GOOGLE FLOW STREAM • FLOW-VIDEO-01</span>
              </div>
              <div class="absolute bottom-2.5 right-2.5 z-20 px-2.5 py-1 rounded-md bg-black/60 backdrop-blur-md border border-white/15 text-[10px] font-mono text-emerald-300">
                60 FPS • WATERMARK SANITIZED
              </div>
            </div>

            <!-- Live Command Bar -->
            <div class="rounded-xl bg-black/55 border border-white/15 p-3 flex items-center justify-between gap-3">
              <div class="text-[12px] text-white/80 font-mono truncate">
                <span class="text-[#ff6b60]">$ kinetix deploy</span> --model kx-4-omni --gpus 64 --region us-east
              </div>
              <a
                href="/design-system#prompts"
                class="shrink-0 px-3.5 py-1.5 rounded-lg bg-[#FA0F00] hover:bg-[#d73220] text-white font-bold text-[12px] transition-colors"
              >
                Prompts →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Extracted Bottom 5-Slot Interactive Glass Dock (`rm-card-progress-bar` — 5000ms Linear Progress) -->
  <div class="relative z-30 max-w-[1440px] w-full mx-auto px-6 sm:px-12 mt-8">
    <div class="flex items-stretch gap-3 overflow-x-auto pb-2 no-scrollbar">
      {
        slides.map((slide, idx) => (
          <button
            type="button"
            data-df-dock-btn={idx}
            class:list={[
              'group relative flex-1 min-w-[200px] text-left rounded-[16px] p-4 transition-all duration-300 ease-[cubic-bezier(0.42,0,0,1)] overflow-hidden border',
              idx === 0
                ? 'bg-white text-[#131313] border-white shadow-xl'
                : 'bg-[#131313]/65 text-white border-white/15 backdrop-blur-xl hover:bg-[#131313]/85',
            ]}
          >
            <div class="flex items-center justify-between mb-3">
              <span
                class="w-6 h-6 rounded-[6px] flex items-center justify-center text-white text-[11px] font-black"
                style={`background: ${slide.badgeColor};`}
              >
                {slide.badgeLabel}
              </span>
              <span class="text-[11px] font-mono opacity-60">0{idx + 1}</span>
            </div>

            <div class="flex items-center justify-between gap-2">
              <span class="font-bold text-[14px] tracking-[-0.01em] truncate">{slide.dockTitle}</span>
              <span class="text-sm transition-transform duration-200 group-hover:translate-x-1">›</span>
            </div>

            <!-- Extracted 5000ms Linear Progress Bar (`rm-card-progress-bar`) -->
            <div class="absolute bottom-0 left-0 right-0 h-[4px] bg-black/10 overflow-hidden">
              <div
                data-df-dock-progress={idx}
                class="h-full w-full origin-left"
                style={`background: ${slide.badgeColor}; transform: translateX(-101%);`}
              />
            </div>
          </button>
        ))
      }

      <!-- Extracted Play/Pause Circular Glass Toggle -->
      <button
        type="button"
        data-df-dock-pause
        aria-label="Pause or resume hero stage cycle"
        class="shrink-0 w-12 h-12 my-auto rounded-full bg-[#131313]/70 border border-white/20 backdrop-blur-xl text-white flex items-center justify-center hover:bg-white hover:text-[#131313] transition-colors"
      >
        <span data-df-pause-icon class="text-xs font-bold tracking-widest">II</span>
      </button>
    </div>
  </div>
</section>

<script>
  const CYCLE_MS = 5000;
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-df-dock-btn]'));
  const progresses = Array.from(document.querySelectorAll<HTMLElement>('[data-df-dock-progress]'));
  const copies = Array.from(document.querySelectorAll<HTMLElement>('[data-df-hero-copy]'));
  const bgs = Array.from(document.querySelectorAll<HTMLElement>('[data-df-hero-bg]'));
  const stageVideos = Array.from(document.querySelectorAll<HTMLVideoElement>('[data-df-hero-stage-video]'));
  const stageSlotLabel = document.querySelector<HTMLElement>('[data-df-stage-slot-label]');
  const pauseBtn = document.querySelector<HTMLButtonElement>('[data-df-dock-pause]');
  const pauseIcon = document.querySelector<HTMLElement>('[data-df-pause-icon]');
  const slotLabels = [
    'LIVE GOOGLE FLOW STREAM • FLOW-VIDEO-01',
    'LIVE GOOGLE FLOW STREAM • FLOW-VIDEO-02',
    'LIVE GOOGLE FLOW STREAM • FLOW-VIDEO-03',
    'LIVE GOOGLE FLOW STREAM • FLOW-VIDEO-04',
    'LIVE GOOGLE FLOW STREAM • FLOW-VIDEO-05',
  ];

  let activeIdx = 0;
  let isPaused = false;
  let startTime = performance.now();

  function activateSlide(index: number) {
    activeIdx = index;
    startTime = performance.now();

    buttons.forEach((btn, i) => {
      if (i === index) {
        btn.className =
          'group relative flex-1 min-w-[200px] text-left rounded-[16px] p-4 transition-all duration-300 ease-[cubic-bezier(0.42,0,0,1)] overflow-hidden border bg-white text-[#131313] border-white shadow-xl';
      } else {
        btn.className =
          'group relative flex-1 min-w-[200px] text-left rounded-[16px] p-4 transition-all duration-300 ease-[cubic-bezier(0.42,0,0,1)] overflow-hidden border bg-[#131313]/65 text-white border-white/15 backdrop-blur-xl hover:bg-[#131313]/85';
      }
    });

    copies.forEach((el, i) => {
      if (i === index) {
        el.classList.remove('opacity-0', 'translate-y-4', 'absolute', 'inset-0', 'pointer-events-none');
        el.classList.add('opacity-100', 'translate-y-0', 'relative');
      } else {
        el.classList.add('opacity-0', 'translate-y-4', 'absolute', 'inset-0', 'pointer-events-none');
        el.classList.remove('opacity-100', 'translate-y-0', 'relative');
      }
    });

    bgs.forEach((el, i) => {
      if (i === index) {
        el.classList.remove('opacity-0', '-z-10', 'pointer-events-none');
        el.classList.add('opacity-100', 'z-0');
      } else {
        el.classList.add('opacity-0', '-z-10', 'pointer-events-none');
        el.classList.remove('opacity-100', 'z-0');
      }
    });

    stageVideos.forEach((vid, i) => {
      if (i === index) {
        vid.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
        vid.classList.add('opacity-100', 'z-10');
      } else {
        vid.classList.add('opacity-0', 'z-0', 'pointer-events-none');
        vid.classList.remove('opacity-100', 'z-10');
      }
    });

    if (stageSlotLabel && slotLabels[index]) {
      stageSlotLabel.textContent = slotLabels[index];
    }

    progresses.forEach((bar) => {
      bar.style.transform = 'translateX(-101%)';
    });
  }

  function tick(now: number) {
    if (!isPaused && progresses[activeIdx]) {
      const elapsed = now - startTime;
      const pct = Math.min(elapsed / CYCLE_MS, 1);
      const translateVal = -101 + pct * 101;
      progresses[activeIdx].style.transform = `translateX(${translateVal}%)`;

      if (pct >= 1) {
        activateSlide((activeIdx + 1) % buttons.length);
      }
    }
    requestAnimationFrame(tick);
  }

  buttons.forEach((btn, idx) => {
    btn.addEventListener('click', () => {
      activateSlide(idx);
    });
  });

  pauseBtn?.addEventListener('click', () => {
    isPaused = !isPaused;
    if (!isPaused) startTime = performance.now();
    if (pauseIcon) pauseIcon.textContent = isPaused ? '▶' : 'II';
  });

  if (buttons.length > 0) {
    activateSlide(0);
    requestAnimationFrame(tick);
  }
</script>
